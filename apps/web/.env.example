# ── Leads Portal Web — environment ──────────────────────────────────────────
# Copy to apps/web/.env.local and adjust as needed.

# Base URL of the NestJS API (includes the /api global prefix).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# JWT signing secret — MUST match apps/api → JWT_SECRET.
# Used server-side only (middleware) to verify the access-token cookie.
JWT_SECRET=change-me-dev-jwt-secret
