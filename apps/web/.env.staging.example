# ── Leads Portal Web — STAGING environment ──────────────────────────────────
# Values for the staging Vercel project (Settings → Environment Variables).

# Staging API base URL, including the /api prefix.
NEXT_PUBLIC_API_URL=https://leads-portal-api-staging.up.railway.app/api

# MUST match the staging API's JWT_SECRET (server-side only — used by proxy.ts).
JWT_SECRET=must-match-staging-api-JWT_SECRET
