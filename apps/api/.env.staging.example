# ── Leads Portal API — STAGING environment ──────────────────────────────────
# Values for the staging Railway service. Set these in Railway → Variables
# (never commit real secrets). Staging is a separate Railway project from prod.

NODE_ENV=production

# Public origins — the staging Vercel + Railway URLs.
FRONTEND_URL=https://leads-portal-web-staging.vercel.app
BACKEND_URL=https://leads-portal-api-staging.up.railway.app

# Reference the staging Postgres plugin (Railway injects this automatically
# when you add the plugin — use ${{ Postgres.DATABASE_URL }}).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Distinct secrets per environment — never share staging/prod secrets.
JWT_SECRET=generate-with-openssl-rand-base64-32
JWT_EXPIRES_IN=1d
ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
INTAKE_HMAC_SECRET=generate-with-openssl-rand-hex-32

# Stripe — staging uses TEST keys (sk_test_… / whsec_…).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

LEAD_DEDUP_WINDOW_DAYS=30
