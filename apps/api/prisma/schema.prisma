// Leads Portal — Prisma schema (Phase 1: full data model)
//
// Conventions:
//   - UUID primary keys (`@db.Uuid`, generated client-side with uuid v4)
//   - timestamptz `created_at` / `updated_at` on every model
//   - DB tables are snake_case plural (`@@map`); fields are snake_case
//   - money is `Decimal` (never Float); JSON blobs are `Json`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  CLIENT
}

enum LeadType {
  SOLAR
  SWEEPSTAKES
  PAYDAY
  HOMEOWNER
}

enum DeliveryMode {
  EXCLUSIVE
  SHARED
}

enum LeadState {
  NEW
  VALIDATING
  VALID
  REJECTED
  MATCHING
  UNSOLD_POOL
  ASSIGNED
  DELIVERED
  ACCEPTED
  REPLACEMENT_REQUESTED
  REPLACED
  CLOSED
}

enum RejectReason {
  INVALID_FORMAT
  UNDELIVERABLE
  DUPLICATE
  SUPPRESSED
}

enum OrderStatus {
  /// Client started but hasn't submitted yet.
  DRAFT
  /// Client submitted — visible to the owning agent, who collects payment off-platform.
  AWAITING_PAYMENT
  /// Agent uploaded the payment screenshot — visible to admin/super-admin for verification.
  PROOF_SUBMITTED
  /// Admin verified the payment screenshot — the order joins the distribution queue.
  ACTIVE
  /// At least one lead has been delivered against this order.
  FULFILLING
  /// `quantity_remaining` hit zero.
  COMPLETED
  /// Admin rejected the proof (with `reject_note`) or the original request.
  REJECTED
  /// Admin paused fulfilment — no new assignments until resumed.
  PAUSED
  /// Agent cancelled an uncollected order, or admin cancelled outright.
  CANCELLED
}

/// How the off-platform payment was made (agent records this when uploading proof).
enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_WALLET
  CASH
  CHECK
  OTHER
}

/// Buyer-facing outreach state on a delivered lead — editable from the Leads
/// sheet by the CLIENT that bought it (and only that client; the row lives on
/// the assignment, not the lead, so each of up to 4 shared-lead buyers tracks
/// their own).
enum FollowupStatus {
  NEW
  CALLED
  NO_ANSWER
  CONVERTED
  DEAD
}

enum SampleRequestStatus {
  PENDING    // submitted by client, waiting for agent to review
  FORWARDED  // agent forwarded to admin
  ASSIGNED   // admin assigned sample leads to client or agent
  REJECTED
}

enum AssignmentType {
  AUTO
  MANUAL
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

enum ReplacementStatus {
  REQUESTED
  REVIEW
  APPROVED
  DENIED
  REPLACED
}

enum TxnType {
  CHARGE
  REFUND
}

enum TxnStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum LandingStatus {
  WORKING
  PUBLISHED
}

enum CampaignAdsType {
  FACEBOOK
  GOOGLE
  TIKTOK
  YOUTUBE
  OTHER
}

/// Account lifecycle for both internal staff (`users`) and buyers (`clients`).
/// Not in the requested enum list, but the `status` fields need a stable type.
enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity — internal staff & buyers
// ─────────────────────────────────────────────────────────────────────────────

/// Internal staff: SUPER_ADMIN / ADMIN / AGENT. Buyers live in `clients`.
model User {
  id            String        @id @default(uuid()) @db.Uuid
  role          Role
  full_name     String
  work_email    String        @unique
  phone         String?
  whatsapp      String?
  password_hash String
  designation   String?
  employee_id   String?
  linkedin_url  String?
  status        AccountStatus @default(ACTIVE)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)

  clients               Client[]
  campaigns             Campaign[]
  approved_orders       Order[]          @relation("OrderApprover")
  payment_uploads       Order[]          @relation("OrderPaymentUploader")
  cancelled_orders      Order[]          @relation("OrderCanceller")
  issued_invoices       Invoice[]        @relation("InvoiceIssuer")
  assignments           LeadAssignment[] @relation("AssignmentAssigner")
  followup_updates      LeadAssignment[] @relation("AssignmentFollowupUpdater")
  reviewed_replacements Replacement[]
  commissions           Commission[]
  audit_logs            AuditLog[]

  sample_requests_as_agent    SampleRequest[] @relation("SampleRequestAgent")
  sample_requests_as_reviewer SampleRequest[] @relation("SampleRequestReviewer")
  sample_deliveries_assigned  SampleDelivery[] @relation("SampleDeliveryAssigner")

  @@map("users")
}

/// Buyers of leads. Each client is owned by exactly one AGENT user.
model Client {
  id            String        @id @default(uuid()) @db.Uuid
  agent_id      String        @db.Uuid
  full_name     String
  business_name String?
  email         String        @unique
  phone         String?
  whatsapp      String?
  address       String?
  password_hash String
  status        AccountStatus @default(ACTIVE)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)

  agent        User             @relation(fields: [agent_id], references: [id])
  orders       Order[]
  assignments  LeadAssignment[]
  replacements Replacement[]
  transactions Transaction[]
  invoices     Invoice[]

  sample_requests   SampleRequest[]
  sample_deliveries SampleDelivery[]

  @@index([agent_id])
  @@map("clients")
}

// ─────────────────────────────────────────────────────────────────────────────
// Acquisition — campaigns & landing pages
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  details         String?
  ads_type        CampaignAdsType
  production_link String?
  budget          Decimal?        @db.Decimal(12, 2)
  day_count       Int?
  results         Json?
  created_by      String          @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)

  creator  User      @relation(fields: [created_by], references: [id])
  leads    Lead[]
  expenses Expense[]

  @@index([created_by])
  @@map("campaigns")
}

model LandingPage {
  id            String        @id @default(uuid()) @db.Uuid
  lead_type     LeadType
  name          String
  web_link      String?
  status        LandingStatus @default(WORKING)
  field_map     Json?
  intake_secret String
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)

  leads Lead[]

  @@map("landing_pages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Leads
// ─────────────────────────────────────────────────────────────────────────────

/// A captured lead. NOTE: the prompt lists two `state` fields — a geographic
/// one and the lifecycle `LeadState`. The geographic column keeps the name
/// `state`; the lifecycle column is `lead_state`.
model Lead {
  id              String        @id @default(uuid()) @db.Uuid
  public_lead_id  String        @unique
  campaign_id     String?       @db.Uuid
  landing_page_id String?       @db.Uuid
  lead_type       LeadType
  source_url      String?
  submission_id   String        @unique
  country         String?
  state           String?
  zip             String?
  full_name       String?
  phone           String?
  email           String?
  address         String?
  qualification   Json?
  consent_text    String?
  consent_ip      String?
  consent_at      DateTime?     @db.Timestamptz(6)
  lead_state      LeadState     @default(NEW)
  reject_reason   RejectReason?
  in_sample_pool  Boolean       @default(false)
  captured_at     DateTime      @default(now()) @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  campaign     Campaign?        @relation(fields: [campaign_id], references: [id])
  landing_page LandingPage?     @relation(fields: [landing_page_id], references: [id])
  assignments  LeadAssignment[]

  replacements_as_original    Replacement[] @relation("OriginalLead")
  replacements_as_replacement Replacement[] @relation("ReplacementLead")
  sample_deliveries           SampleDelivery[]

  @@index([lead_type, country, state])
  @@index([phone])
  @@index([email])
  @@index([lead_state])
  @@map("leads")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sample leads
// ─────────────────────────────────────────────────────────────────────────────

model SampleRequest {
  id            String              @id @default(uuid()) @db.Uuid
  public_id     String              @unique
  client_id     String              @db.Uuid
  agent_id      String              @db.Uuid
  lead_type     LeadType
  quantity      Int
  delivery_mode DeliveryMode
  state_filter  String?
  zip_filter    String?
  notes         String?
  status        SampleRequestStatus @default(PENDING)
  reject_reason String?
  reviewed_by   String?             @db.Uuid
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at    DateTime            @updatedAt @db.Timestamptz(6)

  client     Client          @relation(fields: [client_id], references: [id])
  agent      User            @relation("SampleRequestAgent", fields: [agent_id], references: [id])
  reviewer   User?           @relation("SampleRequestReviewer", fields: [reviewed_by], references: [id])
  deliveries SampleDelivery[]

  @@index([client_id])
  @@index([agent_id])
  @@index([status, lead_type])
  @@map("sample_requests")
}

model SampleDelivery {
  id                String   @id @default(uuid()) @db.Uuid
  sample_request_id String   @db.Uuid
  lead_id           String   @db.Uuid
  client_id         String   @db.Uuid
  assigned_by       String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  sample_request SampleRequest @relation(fields: [sample_request_id], references: [id])
  lead           Lead          @relation(fields: [lead_id], references: [id])
  client         Client        @relation(fields: [client_id], references: [id])
  assigner       User          @relation("SampleDeliveryAssigner", fields: [assigned_by], references: [id])

  @@unique([sample_request_id, lead_id])
  @@index([sample_request_id])
  @@index([client_id])
  @@map("sample_deliveries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders & fulfilment
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id                 String       @id @default(uuid()) @db.Uuid
  public_order_id    String       @unique
  client_id          String       @db.Uuid
  lead_type          LeadType
  criteria           Json?
  delivery_mode      DeliveryMode
  quantity_paid      Int
  quantity_remaining Int
  daily_cap          Int?
  queue_priority     Int          @default(0)
  /// Max acceptable lead age in hours (null = no freshness constraint).
  freshness_required Int?
  /// When the client wants the leads delivered by (set on the order request).
  needed_by          DateTime?    @db.Timestamptz(6)
  unit_price         Decimal      @db.Decimal(10, 2)
  total_amount       Decimal      @db.Decimal(12, 2)
  status             OrderStatus  @default(DRAFT)
  requirements       String?
  reject_note        String?
  /// Admin / Super-Admin who accepted the proof (or rejected it).
  approved_by        String?      @db.Uuid

  // ── Off-platform payment (WhatsApp) — proof uploaded by the owning agent ──
  /// Relative path inside `UPLOAD_DIR` of the payment screenshot file.
  payment_screenshot_path     String?
  /// Original filename as uploaded.
  payment_screenshot_filename String?
  /// File size in bytes.
  payment_screenshot_size     Int?
  /// MIME type (image/jpeg, image/png, image/webp, application/pdf).
  payment_screenshot_mime     String?
  /// SHA-256 of the screenshot bytes — used for cross-order dedupe forensics.
  payment_screenshot_sha256   String?
  /// Agent (User) who uploaded the proof.
  payment_uploaded_by         String?        @db.Uuid
  payment_uploaded_at         DateTime?      @db.Timestamptz(6)
  payment_method              PaymentMethod?
  /// Free-form txn id / sender name / last 4 digits from the screenshot.
  payment_reference           String?
  /// Agent's free-form note about the payment (amount confirmation, etc.).
  payment_note                String?

  // ── Cancellation ──────────────────────────────────────────────────────────
  cancelled_by     String?   @db.Uuid
  cancelled_at     DateTime? @db.Timestamptz(6)
  cancelled_reason String?

  requested_at   DateTime? @db.Timestamptz(6)
  /// When the order was accepted by admin (becomes ACTIVE). Tiebreak in the queue.
  paid_at        DateTime? @db.Timestamptz(6)
  /// When this order last received a lead — used for the round-robin tiebreak.
  last_served_at DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)

  client           Client           @relation(fields: [client_id], references: [id])
  approver         User?            @relation("OrderApprover", fields: [approved_by], references: [id])
  payment_uploader User?            @relation("OrderPaymentUploader", fields: [payment_uploaded_by], references: [id])
  canceller        User?            @relation("OrderCanceller", fields: [cancelled_by], references: [id])
  assignments      LeadAssignment[]
  replacements     Replacement[]
  transactions     Transaction[]
  invoices         Invoice[]
  commissions      Commission[]

  @@index([status, lead_type])
  @@index([queue_priority, paid_at])
  @@index([client_id])
  @@map("orders")
}

model LeadAssignment {
  id                String         @id @default(uuid()) @db.Uuid
  lead_id           String         @db.Uuid
  order_id          String         @db.Uuid
  client_id         String         @db.Uuid
  assignment_type   AssignmentType
  /// Denormalised from the order. Backs the partial unique index that lets an
  /// EXCLUSIVE lead have exactly one assignment.
  delivery_mode     DeliveryMode
  assigned_by       String?        @db.Uuid
  delivery_method   String?
  delivery_status   DeliveryStatus @default(PENDING)
  /// Number of delivery attempts so far — drives RETRYING → FAILED.
  delivery_attempts Int            @default(0)
  delivered_at      DateTime?      @db.Timestamptz(6)
  /// Revenue is booked only once delivery is confirmed by the client.
  revenue           Decimal?       @db.Decimal(10, 2)
  replacement_code  String?        @unique

  // ── Client-side follow-up tracking (editable from the Leads sheet) ────────
  followup_status     FollowupStatus @default(NEW)
  followup_note       String?
  followup_updated_at DateTime?      @db.Timestamptz(6)
  followup_updated_by String?        @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  lead             Lead   @relation(fields: [lead_id], references: [id])
  order            Order  @relation(fields: [order_id], references: [id])
  client           Client @relation(fields: [client_id], references: [id])
  assigner         User?  @relation("AssignmentAssigner", fields: [assigned_by], references: [id])
  followup_updater User?  @relation("AssignmentFollowupUpdater", fields: [followup_updated_by], references: [id])

  @@unique([lead_id, order_id])
  @@index([lead_id])
  @@index([order_id])
  @@index([client_id])
  @@index([client_id, followup_status])
  @@map("lead_assignments")
}

/// Data-driven column schema for the Leads sheet. One row per visible column
/// per LeadType. Admins can re-order / rename / add columns from the UI later
/// without redeploying. The web `LeadsSheet` reads `GET /api/lead-type-columns`
/// to render headers + bind cells.
///
/// `source` is a dotted path the renderer resolves at display time:
///   lead.<canonical_col>            — Lead.full_name / email / phone / ...
///   qualification.<key>             — anywhere in Lead.qualification JSON
///   system.<key>                    — public_lead_id / captured_at / lead_state / landing_page / ...
///   assignment.<key>                — delivery_status / delivered_at / followup_status
///   order.public_order_id
///   replacement.status
///
/// `data_type` decides cell rendering: string | phone | email | date | datetime
///                                     | money | integer | boolean | enum
/// `sensitive=true` → cell is masked (kind from `mask_kind`) unless explicitly
/// revealed; reveal is audit-logged. Sensitive fields are stored encrypted
/// in `qualification` (AES-256-GCM, key from ENCRYPTION_KEY).
model LeadTypeColumn {
  id              String   @id @default(uuid()) @db.Uuid
  lead_type       LeadType
  position        Int
  field_key       String
  label           String
  source          String
  data_type       String   @default("string")
  sensitive       Boolean  @default(false)
  /// One of: ssn | account | routing | dl | last4 | full (only used when sensitive=true).
  mask_kind       String?
  default_visible Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  @@unique([lead_type, position])
  @@unique([lead_type, field_key])
  @@index([lead_type, default_visible])
  @@map("lead_type_columns")
}

model Replacement {
  id                  String            @id @default(uuid()) @db.Uuid
  original_lead_id    String            @db.Uuid
  order_id            String            @db.Uuid
  client_id           String            @db.Uuid
  reason              String?
  status              ReplacementStatus @default(REQUESTED)
  /// Reviewer's note — recorded when a replacement is denied (or approved).
  review_note         String?
  reviewed_by         String?           @db.Uuid
  replacement_lead_id String?           @db.Uuid
  replacement_code    String?
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @updatedAt @db.Timestamptz(6)

  original_lead    Lead   @relation("OriginalLead", fields: [original_lead_id], references: [id])
  replacement_lead Lead?  @relation("ReplacementLead", fields: [replacement_lead_id], references: [id])
  order            Order  @relation(fields: [order_id], references: [id])
  client           Client @relation(fields: [client_id], references: [id])
  reviewer         User?  @relation(fields: [reviewed_by], references: [id])

  @@index([original_lead_id])
  @@index([order_id])
  @@index([client_id])
  @@map("replacements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────────────────────────────────────

/// Off-platform payment record. Created once the admin accepts the
/// proof-of-payment screenshot; refunds (handled off-platform via the agent)
/// are tracked as a second row.
model Transaction {
  id                String         @id @default(uuid()) @db.Uuid
  order_id          String         @db.Uuid
  client_id         String         @db.Uuid
  amount            Decimal        @db.Decimal(12, 2)
  type              TxnType
  status            TxnStatus      @default(PENDING)
  payment_method    PaymentMethod?
  /// Free-form txn id / sender name / last 4 digits from the agent.
  payment_reference String?
  recorded_by       String?        @db.Uuid
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @updatedAt @db.Timestamptz(6)

  order  Order  @relation(fields: [order_id], references: [id])
  client Client @relation(fields: [client_id], references: [id])

  @@index([order_id])
  @@index([client_id])
  @@map("transactions")
}

/// Internal invoice generated when an order is accepted. The PDF is rendered
/// on-demand and stored under `UPLOAD_DIR/invoices/`. `pdf_path` is relative
/// to that root; the API serves it through `GET /api/invoices/:id/pdf` after
/// re-checking the caller's role/ownership.
model Invoice {
  id             String    @id @default(uuid()) @db.Uuid
  order_id       String    @db.Uuid
  client_id      String    @db.Uuid
  invoice_number String    @unique
  amount         Decimal   @db.Decimal(12, 2)
  issued_at      DateTime? @db.Timestamptz(6)
  issued_by      String?   @db.Uuid
  pdf_path       String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)

  order  Order  @relation(fields: [order_id], references: [id])
  client Client @relation(fields: [client_id], references: [id])
  issuer User?  @relation("InvoiceIssuer", fields: [issued_by], references: [id])

  @@index([order_id])
  @@index([client_id])
  @@map("invoices")
}

// ─────────────────────────────────────────────────────────────────────────────
// Compliance, finance & operations
// ─────────────────────────────────────────────────────────────────────────────

model SuppressionList {
  id         String   @id @default(uuid()) @db.Uuid
  phone      String?
  email      String?
  reason     String?
  added_at   DateTime @default(now()) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([phone])
  @@index([email])
  @@map("suppression_list")
}

model Commission {
  id         String   @id @default(uuid()) @db.Uuid
  agent_id   String   @db.Uuid
  order_id   String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  rate       Decimal  @db.Decimal(5, 4)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  agent User  @relation(fields: [agent_id], references: [id])
  order Order @relation(fields: [order_id], references: [id])

  @@index([agent_id])
  @@index([order_id])
  @@map("commissions")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  campaign_id String?  @db.Uuid
  incurred_at DateTime @default(now()) @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  campaign Campaign? @relation(fields: [campaign_id], references: [id])

  @@index([campaign_id])
  @@map("expenses")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String
  entity        String
  entity_id     String?
  before        Json?
  after         Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  actor User? @relation(fields: [actor_user_id], references: [id])

  @@index([actor_user_id])
  @@index([entity, entity_id])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// Configuration tables
// ─────────────────────────────────────────────────────────────────────────────

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json?
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@map("settings")
}

model ApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  key_prefix      String?
  encrypted_value String
  last_used_at    DateTime? @db.Timestamptz(6)
  revoked_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  @@map("api_keys")
}

model Integration {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String   @unique
  config     Json?
  is_enabled Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("integrations")
}
