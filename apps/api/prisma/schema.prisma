// Leads Portal — Prisma schema (Phase 1: full data model)
//
// Conventions:
//   - UUID primary keys (`@db.Uuid`, generated client-side with uuid v4)
//   - timestamptz `created_at` / `updated_at` on every model
//   - DB tables are snake_case plural (`@@map`); fields are snake_case
//   - money is `Decimal` (never Float); JSON blobs are `Json`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  CLIENT
}

enum LeadType {
  SOLAR
  SWEEPSTAKES
  PAYDAY
  HOMEOWNER
}

enum DeliveryMode {
  EXCLUSIVE
  SHARED
}

enum LeadState {
  NEW
  VALIDATING
  VALID
  REJECTED
  MATCHING
  UNSOLD_POOL
  ASSIGNED
  DELIVERED
  ACCEPTED
  REPLACEMENT_REQUESTED
  REPLACED
  CLOSED
}

enum RejectReason {
  INVALID_FORMAT
  UNDELIVERABLE
  DUPLICATE
  SUPPRESSED
}

enum OrderStatus {
  DRAFT
  REQUESTED
  ACCEPTED
  REJECTED
  INVOICED
  PAID
  ACTIVE
  FULFILLING
  COMPLETED
  PAUSED
  CANCELLED
  PAYMENT_FAILED
}

enum AssignmentType {
  AUTO
  MANUAL
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

enum ReplacementStatus {
  REQUESTED
  REVIEW
  APPROVED
  DENIED
  REPLACED
}

enum TxnType {
  CHARGE
  REFUND
}

enum TxnStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum LandingStatus {
  WORKING
  PUBLISHED
}

enum CampaignAdsType {
  FACEBOOK
  GOOGLE
  TIKTOK
  YOUTUBE
  OTHER
}

/// Account lifecycle for both internal staff (`users`) and buyers (`clients`).
/// Not in the requested enum list, but the `status` fields need a stable type.
enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity — internal staff & buyers
// ─────────────────────────────────────────────────────────────────────────────

/// Internal staff: SUPER_ADMIN / ADMIN / AGENT. Buyers live in `clients`.
model User {
  id            String        @id @default(uuid()) @db.Uuid
  role          Role
  full_name     String
  work_email    String        @unique
  phone         String?
  whatsapp      String?
  password_hash String
  designation   String?
  employee_id   String?
  linkedin_url  String?
  status        AccountStatus @default(ACTIVE)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)

  clients               Client[]
  campaigns             Campaign[]
  approved_orders       Order[]
  assignments           LeadAssignment[]
  reviewed_replacements Replacement[]
  commissions           Commission[]
  audit_logs            AuditLog[]

  @@map("users")
}

/// Buyers of leads. Each client is owned by exactly one AGENT user.
model Client {
  id                 String        @id @default(uuid()) @db.Uuid
  agent_id           String        @db.Uuid
  full_name          String
  business_name      String?
  email              String        @unique
  phone              String?
  whatsapp           String?
  address            String?
  password_hash      String
  stripe_customer_id String?
  status             AccountStatus @default(ACTIVE)
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at         DateTime      @updatedAt @db.Timestamptz(6)

  agent        User             @relation(fields: [agent_id], references: [id])
  orders       Order[]
  assignments  LeadAssignment[]
  replacements Replacement[]
  transactions Transaction[]
  invoices     Invoice[]

  @@index([agent_id])
  @@map("clients")
}

// ─────────────────────────────────────────────────────────────────────────────
// Acquisition — campaigns & landing pages
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  details         String?
  ads_type        CampaignAdsType
  production_link String?
  budget          Decimal?        @db.Decimal(12, 2)
  day_count       Int?
  results         Json?
  created_by      String          @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)

  creator  User      @relation(fields: [created_by], references: [id])
  leads    Lead[]
  expenses Expense[]

  @@index([created_by])
  @@map("campaigns")
}

model LandingPage {
  id            String        @id @default(uuid()) @db.Uuid
  lead_type     LeadType
  name          String
  web_link      String?
  status        LandingStatus @default(WORKING)
  field_map     Json?
  intake_secret String
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)

  leads Lead[]

  @@map("landing_pages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Leads
// ─────────────────────────────────────────────────────────────────────────────

/// A captured lead. NOTE: the prompt lists two `state` fields — a geographic
/// one and the lifecycle `LeadState`. The geographic column keeps the name
/// `state`; the lifecycle column is `lead_state`.
model Lead {
  id              String        @id @default(uuid()) @db.Uuid
  public_lead_id  String        @unique
  campaign_id     String?       @db.Uuid
  landing_page_id String?       @db.Uuid
  lead_type       LeadType
  source_url      String?
  submission_id   String        @unique
  country         String?
  state           String?
  zip             String?
  full_name       String?
  phone           String?
  email           String?
  address         String?
  qualification   Json?
  consent_text    String?
  consent_ip      String?
  consent_at      DateTime?     @db.Timestamptz(6)
  lead_state      LeadState     @default(NEW)
  reject_reason   RejectReason?
  captured_at     DateTime      @default(now()) @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  campaign     Campaign?        @relation(fields: [campaign_id], references: [id])
  landing_page LandingPage?     @relation(fields: [landing_page_id], references: [id])
  assignments  LeadAssignment[]

  replacements_as_original    Replacement[] @relation("OriginalLead")
  replacements_as_replacement Replacement[] @relation("ReplacementLead")

  @@index([lead_type, country, state])
  @@index([phone])
  @@index([email])
  @@index([lead_state])
  @@map("leads")
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders & fulfilment
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id                  String       @id @default(uuid()) @db.Uuid
  public_order_id     String       @unique
  client_id           String       @db.Uuid
  lead_type           LeadType
  criteria            Json?
  delivery_mode       DeliveryMode
  quantity_paid       Int
  quantity_remaining  Int
  daily_cap           Int?
  queue_priority      Int          @default(0)
  /// Max acceptable lead age in hours (null = no freshness constraint).
  freshness_required  Int?
  unit_price          Decimal      @db.Decimal(10, 2)
  total_amount        Decimal      @db.Decimal(12, 2)
  status              OrderStatus  @default(DRAFT)
  requirements        String?
  reject_note         String?
  approved_by         String?      @db.Uuid
  stripe_invoice_id   String?
  stripe_payment_link String?
  requested_at        DateTime?    @db.Timestamptz(6)
  paid_at             DateTime?    @db.Timestamptz(6)
  /// When this order last received a lead — used for the round-robin tiebreak.
  last_served_at      DateTime?    @db.Timestamptz(6)
  created_at          DateTime     @default(now()) @db.Timestamptz(6)
  updated_at          DateTime     @updatedAt @db.Timestamptz(6)

  client       Client           @relation(fields: [client_id], references: [id])
  approver     User?            @relation(fields: [approved_by], references: [id])
  assignments  LeadAssignment[]
  replacements Replacement[]
  transactions Transaction[]
  invoices     Invoice[]
  commissions  Commission[]

  @@index([status, lead_type])
  @@index([queue_priority, paid_at])
  @@index([client_id])
  @@map("orders")
}

model LeadAssignment {
  id                String         @id @default(uuid()) @db.Uuid
  lead_id           String         @db.Uuid
  order_id          String         @db.Uuid
  client_id         String         @db.Uuid
  assignment_type   AssignmentType
  /// Denormalised from the order. Backs the partial unique index that lets an
  /// EXCLUSIVE lead have exactly one assignment.
  delivery_mode     DeliveryMode
  assigned_by       String?        @db.Uuid
  delivery_method   String?
  delivery_status   DeliveryStatus @default(PENDING)
  /// Number of delivery attempts so far — drives RETRYING → FAILED.
  delivery_attempts Int            @default(0)
  delivered_at      DateTime?      @db.Timestamptz(6)
  /// Revenue is booked only once delivery is confirmed by the client.
  revenue           Decimal?       @db.Decimal(10, 2)
  replacement_code  String?        @unique
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @updatedAt @db.Timestamptz(6)

  lead     Lead   @relation(fields: [lead_id], references: [id])
  order    Order  @relation(fields: [order_id], references: [id])
  client   Client @relation(fields: [client_id], references: [id])
  assigner User?  @relation(fields: [assigned_by], references: [id])

  @@unique([lead_id, order_id])
  @@index([lead_id])
  @@index([order_id])
  @@index([client_id])
  @@map("lead_assignments")
}

model Replacement {
  id                  String            @id @default(uuid()) @db.Uuid
  original_lead_id    String            @db.Uuid
  order_id            String            @db.Uuid
  client_id           String            @db.Uuid
  reason              String?
  status              ReplacementStatus @default(REQUESTED)
  /// Reviewer's note — recorded when a replacement is denied (or approved).
  review_note         String?
  reviewed_by         String?           @db.Uuid
  replacement_lead_id String?           @db.Uuid
  replacement_code    String?
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @updatedAt @db.Timestamptz(6)

  original_lead    Lead   @relation("OriginalLead", fields: [original_lead_id], references: [id])
  replacement_lead Lead?  @relation("ReplacementLead", fields: [replacement_lead_id], references: [id])
  order            Order  @relation(fields: [order_id], references: [id])
  client           Client @relation(fields: [client_id], references: [id])
  reviewer         User?  @relation(fields: [reviewed_by], references: [id])

  @@index([original_lead_id])
  @@index([order_id])
  @@index([client_id])
  @@map("replacements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────────────────────────────────────

model Transaction {
  id                String    @id @default(uuid()) @db.Uuid
  order_id          String    @db.Uuid
  client_id         String    @db.Uuid
  stripe_payment_id String?
  amount            Decimal   @db.Decimal(12, 2)
  type              TxnType
  status            TxnStatus @default(PENDING)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  order  Order  @relation(fields: [order_id], references: [id])
  client Client @relation(fields: [client_id], references: [id])

  @@index([order_id])
  @@index([client_id])
  @@map("transactions")
}

model Invoice {
  id             String    @id @default(uuid()) @db.Uuid
  order_id       String    @db.Uuid
  client_id      String    @db.Uuid
  invoice_number String    @unique
  amount         Decimal   @db.Decimal(12, 2)
  issued_at      DateTime? @db.Timestamptz(6)
  pdf_url        String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)

  order  Order  @relation(fields: [order_id], references: [id])
  client Client @relation(fields: [client_id], references: [id])

  @@index([order_id])
  @@index([client_id])
  @@map("invoices")
}

// ─────────────────────────────────────────────────────────────────────────────
// Compliance, finance & operations
// ─────────────────────────────────────────────────────────────────────────────

model SuppressionList {
  id         String   @id @default(uuid()) @db.Uuid
  phone      String?
  email      String?
  reason     String?
  added_at   DateTime @default(now()) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([phone])
  @@index([email])
  @@map("suppression_list")
}

model Commission {
  id         String   @id @default(uuid()) @db.Uuid
  agent_id   String   @db.Uuid
  order_id   String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  rate       Decimal  @db.Decimal(5, 4)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  agent User  @relation(fields: [agent_id], references: [id])
  order Order @relation(fields: [order_id], references: [id])

  @@index([agent_id])
  @@index([order_id])
  @@map("commissions")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  campaign_id String?  @db.Uuid
  incurred_at DateTime @default(now()) @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  campaign Campaign? @relation(fields: [campaign_id], references: [id])

  @@index([campaign_id])
  @@map("expenses")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String
  entity        String
  entity_id     String?
  before        Json?
  after         Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  actor User? @relation(fields: [actor_user_id], references: [id])

  @@index([actor_user_id])
  @@index([entity, entity_id])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// Configuration tables
// ─────────────────────────────────────────────────────────────────────────────

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json?
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@map("settings")
}

model ApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  key_prefix      String?
  encrypted_value String
  last_used_at    DateTime? @db.Timestamptz(6)
  revoked_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  @@map("api_keys")
}

model Integration {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String   @unique
  config     Json?
  is_enabled Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("integrations")
}
