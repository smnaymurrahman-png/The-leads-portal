# ── Leads Portal API — environment ──────────────────────────────────────────
# Copy to apps/api/.env and fill in real values. Never commit the real .env.

# Runtime
NODE_ENV=development
PORT=4000

# Public origins
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# PostgreSQL connection string (Railway).
# Railway → your Postgres service → "Connect" tab → copy the connection URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Auth — secret used to sign JWT access tokens (Phase 2).
# Generate one with:  openssl rand -base64 32
# IMPORTANT: the web app must use the SAME value (apps/web → JWT_SECRET).
JWT_SECRET=change-me-dev-jwt-secret

# Access-token lifetime ("15m", "1d", "7d", ...).
JWT_EXPIRES_IN=1d

# ── File storage (Railway persistent volume) ───────────────────────────────
# Payment-proof screenshots (uploaded by agents) and generated invoice PDFs.
#   Local dev: keep the default ./uploads (gitignored).
#   Railway:   mount your volume here, e.g. /var/lib/leads-portal/uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10
# HMAC secret for signing short-lived URL tokens that protect file downloads.
# Generate with: openssl rand -base64 32
UPLOAD_SIGNING_SECRET=change-me-dev-upload-signing-secret
# Validity window (seconds) for the upload-fetch tokens.
UPLOAD_TOKEN_TTL_SECONDS=600

# Lead intake — shared secret for verifying HMAC-signed webhook requests.
# Generate one with:  openssl rand -hex 32
# Note: each landing page also has its own per-page `intake_secret`.
INTAKE_HMAC_SECRET=change-me-dev-hmac-secret

# Lead deduplication window in days (phone/email reuse within this = duplicate).
LEAD_DEDUP_WINDOW_DAYS=30

# Encryption key for API keys stored at rest (AES-256-GCM).
# Generate one with:  openssl rand -base64 32
ENCRYPTION_KEY=change-me-dev-encryption-key
