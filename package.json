{
  "name": "leads-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-vertical lead-generation management and live distribution platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "dev:api": "pnpm --filter @leads-portal/api dev",
    "dev:web": "pnpm --filter @leads-portal/web dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
